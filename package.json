  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.10.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
